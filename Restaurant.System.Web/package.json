{
  "name": "restaurant.system.web",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr": "node dist/Restaurant.System.Web/server/server.mjs",
    "lint": "ng lint",
    "build:tailwind": "node build-tailwind.js",
    "serve:dev": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng serve --configuration development",
    "build:dev": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng build --configuration development --watch=false --progress=false",
    "build:release": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng build --configuration production --watch=false --source-map=false  --progress=false",
    "build:beta": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng build --configuration beta --watch=false --source-map=false  --progress=false",
    "build:forms": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng build forms --watch=false",
    "build:dialogs": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng build dialogs --watch=false"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-server": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/ssr": "^22.1.3",
    "@napi-rs/wasm-runtime": "^1.2.2",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@rs/dialogs": "file:dist/@rs/dialogs",
    "@rs/forms": "file:dist/@rs/forms",
    "bootstrap": "^5.3.8",
    "dayjs": "^1.11.21",
    "express": "^5.2.1",
    "material-symbols": "^0.45.10",
    "ngx-mask": "^22.1.0",
    "ngx-toastr": "^20.0.5",
    "rxjs": "^7.4.0",
    "tslib": "^2.8.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "angular-eslint": "^22.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "ng-packagr": "^22.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "projects",
    "projects/libs/*"
  ]
}
