{
  "name": "restaurant.system.web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr": "node dist/Restaurant.System.Web/server/server.mjs",
    "lint": "ng lint",
    "build:tailwind": "node build-tailwind.js",
    "sd": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng serve --configuration development",
    "bd": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build --configuration development --watch=false --progress=false",
    "br": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng build --configuration production --watch=false --source-map=false  --progress=false",
    "bb": "node --max_old_space_size=6144 node_modules/@angular/cli/bin/ng build --configuration beta --watch=false --source-map=false  --progress=false",
    "forms": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build forms --watch=false",
    "dialogs": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build dialogs --watch=false"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@LeeZX24/dialogs": "0.0.10",
    "@LeeZX24/forms": "^0.0.4",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "material-symbols": "^0.48.1",
    "ngx-mask": "^22.2.5",
    "ngx-toastr": "^20.0.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.4",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "ngx-toastr": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@jridgewell/sourcemap-codec": "1.6.0"
  }
}
